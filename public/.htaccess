# Xserver（Apache）用。dist/ ごと rsync で配信されるので、ここで管理する。

ErrorDocument 404 /404.html

# 旧・競馬予想サイト（2026年8〜9月）のURL。
# 別サイトとして移設する場合は、ここを 301 リダイレクトに書き換える。
<IfModule mod_alias.c>
  RedirectMatch gone ^/(races|results|logic)(/.*)?$
  RedirectMatch gone ^/(disclaimer|terms)/?$
</IfModule>

# CSS・JS・最適化画像はビルドのたびにファイル名が変わるので長期キャッシュでよい
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
