---
import { Image } from 'astro:assets';
import { WORKS } from '../data/works';

interface Props {
  /** 取り組みの箇条書きまで出す（実績ページ用） */
  detailed?: boolean;
  /** 見出しレベル */
  headingLevel?: 'h2' | 'h3';
}

const { detailed = false, headingLevel: H = 'h3' } = Astro.props;
---

<ul class:list={['grid gap-6 md:gap-8', detailed ? 'md:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-3']}>
  {
    WORKS.map((w) => (
      <li class="fade-in">
        <article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-white transition-shadow hover:shadow-xl hover:shadow-brand/5">
          <a href={w.url} target="_blank" rel="noopener" class="relative block aspect-[1200/630] overflow-hidden bg-ground">
            <Image
              src={w.image}
              alt={w.alt}
              widths={[400, 800, 1200]}
              sizes={detailed ? '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 rounded-full bg-white/95 px-3 py-1 text-[11px] font-bold text-ink shadow-sm">
              {w.location}
            </span>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <p class="text-xs font-bold text-brand">{w.industry}</p>
            <H class="mt-1.5 text-lg font-bold">{w.client}</H>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{w.summary}</p>
            {detailed && (
              <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm">
                {w.points.map((p) => (
                  <li class="flex gap-2">
                    <span class="text-brand" aria-hidden="true">●</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            )}
            <a
              href={w.url}
              target="_blank"
              rel="noopener"
              class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-brand hover:underline"
            >
              サイトを見る<span class="sr-only">（{w.client}・別ウィンドウ）</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L15 6.42V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z" />
                <path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z" />
              </svg>
            </a>
          </div>
        </article>
      </li>
    ))
  }
</ul>
