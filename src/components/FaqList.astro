---
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  headingLevel?: 'h3' | 'h4';
}

const { items, headingLevel: H = 'h3' } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((f) => (
      <details class="faq group rounded-2xl border border-line bg-white open:shadow-sm">
        <summary class="flex cursor-pointer list-none items-start gap-4 p-5 md:p-6">
          <span class="font-[family-name:var(--font-en)] text-lg leading-7 font-bold text-brand" aria-hidden="true">Q</span>
          <H class="flex-1 leading-7 font-bold">{f.q}</H>
          <svg class="mt-1.5 h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.2 7.2a1 1 0 0 1 1.4 0L10 10.6l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.6a1 1 0 0 1 0-1.4Z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="flex gap-4 px-5 pb-6 md:px-6">
          <span class="font-[family-name:var(--font-en)] text-lg leading-7 font-bold text-accent" aria-hidden="true">A</span>
          <p class="flex-1 leading-7 text-ink-2">{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
