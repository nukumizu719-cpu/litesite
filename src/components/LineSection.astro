---
import { LINE_URL } from '../config';
---

{
  LINE_URL && (
    <section class="mx-auto max-w-3xl px-5">
      <div class="fade-in rounded-lg border border-line bg-surface p-7 md:p-9">
        <p class="font-[family-name:var(--font-mono)] text-[10px] tracking-[0.16em] text-dirt uppercase">
          LINE
        </p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-xl font-bold text-balance md:text-2xl">
          更新通知と、公開前の一言をLINEで
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-ink-2">
          新しい予想を公開したときの通知に加えて、記事にするほどではない軽い狙い目や、
          直前のオッズを見ての方針変更をお送りします。登録は無料、通知のみで営業はしません。
        </p>
        <a
          href={LINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#06C755] px-6 py-3 text-sm font-bold text-white transition-transform hover:scale-[1.03] active:scale-95"
        >
          LINEで友だち追加
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  )
}
