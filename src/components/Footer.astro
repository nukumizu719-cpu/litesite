---
import { NAV, LEGAL_NAV, SITE, BUSINESS, AREAS, LINE_URL } from '../config';

const year = new Date().getFullYear();
---

<footer class="bg-ink pt-16 pb-28 text-slate-300 md:pb-12">
  <div class="container-x">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="font-[family-name:var(--font-en)] text-2xl font-bold tracking-tight text-white">
          {SITE.name}<span class="text-brand-line">.jp</span>
        </p>
        <p class="mt-1 text-sm font-bold text-white">ライトサイト｜名古屋・安城のホームページ制作</p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-slate-400">
          表示が速く、管理の手間がかからない静的サイトで、愛知県の個人事業主・小規模事業者の集客を支えます。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact/" data-cta="footer" class="btn btn-primary px-6 py-3 text-sm">無料相談・お見積り</a>
          {LINE_URL && (
            <a href={LINE_URL} target="_blank" rel="noopener noreferrer" data-cta="footer" class="btn btn-line px-6 py-3 text-sm">
              LINEで相談
            </a>
          )}
        </div>
      </div>

      <nav class="md:col-span-3" aria-label="フッターメニュー">
        <p class="text-xs font-bold tracking-[0.18em] text-white uppercase">Menu</p>
        <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm md:grid-cols-1">
          <li><a href="/" class="hover:text-white">トップ</a></li>
          {NAV.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
          <li><a href="/contact/" class="hover:text-white">お問い合わせ</a></li>
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="text-xs font-bold tracking-[0.18em] text-white uppercase">Area</p>
        <p class="mt-5 text-sm leading-relaxed">
          <strong class="text-white">{AREAS.main.join('・')}</strong>を中心に、{AREAS.nearby.join('・')}など愛知県全域に対応しています。県外のお客様はオンラインで対応します。
        </p>
        <dl class="mt-5 space-y-1 text-xs text-slate-400">
          <div class="flex gap-2"><dt>所在地</dt><dd>{BUSINESS.region}{BUSINESS.locality}</dd></div>
          <div class="flex gap-2"><dt>営業時間</dt><dd>{BUSINESS.hours}</dd></div>
          <div class="flex gap-2"><dt>メール</dt><dd>{BUSINESS.email}</dd></div>
        </dl>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse gap-4 border-t border-white/10 pt-8 text-xs text-slate-500 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {SITE.titleSuffix}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {LEGAL_NAV.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
