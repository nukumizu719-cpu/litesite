---
import { LINE_URL } from '../config';

// 問い合わせページと、LINE未開設のときは出さない
const path = Astro.url.pathname.replace(/\/$/, '');
const hidden = !LINE_URL || path === '/contact' || path === '/thanks';
---

{
  !hidden && (
    <div class="fixed right-4 bottom-4 z-40 md:right-6 md:bottom-6">
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2 rounded-full bg-[#06C755] px-5 py-3 text-sm font-bold text-white shadow-lg transition-transform hover:scale-105 active:scale-95"
      >
        LINEで予想を受け取る
        <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  )
}
