---
import { SITE, NAV } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-50 w-full border-b border-line bg-ground/90 backdrop-blur-md supports-[backdrop-filter]:bg-ground/75"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 md:h-[4.5rem]">
    <a href="/" class="z-[60] shrink-0 leading-none transition-opacity hover:opacity-70">
      <span class="block font-[family-name:var(--font-display)] text-[1.35rem] font-extrabold tracking-tight md:text-[1.5rem]">
        {SITE.name}
      </span>
      <span class="mt-0.5 block font-[family-name:var(--font-mono)] text-[9px] tracking-[0.18em] text-muted uppercase">
        {SITE.nameEn}
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <div class="flex items-center gap-1 md:gap-7">
      <nav
        class="mobile-nav invisible fixed inset-0 z-[55] flex translate-y-[-12px] flex-col items-center justify-center gap-2 bg-ground opacity-0 transition-all duration-300 md:visible md:static md:translate-y-0 md:flex-row md:bg-transparent md:opacity-100"
        aria-label="メインナビゲーション"
      >
        <ul class="flex flex-col items-center gap-6 text-lg font-bold md:flex-row md:gap-7 md:text-[0.9rem] md:font-semibold">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-turf',
                    isActive(item.href) ? 'text-turf' : 'text-ink-2',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        type="button"
        id="theme-toggle"
        aria-label="配色を切り替える"
        class="z-[60] grid h-10 w-10 place-items-center rounded-md border border-line-soft text-ink-2 transition-colors hover:border-turf hover:text-turf"
      >
        <svg class="h-[18px] w-[18px] dark-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="hidden h-[18px] w-[18px] dark-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <label
        for="nav-toggle"
        class="hamburger z-[60] grid h-10 w-10 cursor-pointer place-items-center rounded-md border border-line-soft md:hidden"
        aria-label="メニューを開閉する"
      >
        <span class="grid gap-[5px]">
          <span class="line block h-[2px] w-5 bg-ink"></span>
          <span class="line block h-[2px] w-5 bg-ink"></span>
          <span class="line block h-[2px] w-5 bg-ink"></span>
        </span>
      </label>
    </div>
  </div>
</header>

<style>
  #nav-toggle:checked ~ div .hamburger .line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #nav-toggle:checked ~ div .hamburger .line:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle:checked ~ div .hamburger .line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  #nav-toggle:checked ~ div .mobile-nav {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .line {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;
  }

  /* テーマアイコンの出し分け。3状態すべてを明示する */
  :root[data-theme='dark'] .dark-hide { display: none; }
  :root[data-theme='dark'] .dark-show { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .dark-hide { display: none; }
    :root:not([data-theme='light']) .dark-show { display: block; }
  }
</style>

<script>
  // モバイルメニュー：リンクを踏んだら閉じる／背面スクロールを止める
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const setLock = (locked: boolean) => {
    document.body.style.overflow = locked ? 'hidden' : '';
  };
  toggle?.addEventListener('change', () => setLock(toggle.checked));
  document.querySelectorAll('.mobile-nav a').forEach((a) =>
    a.addEventListener('click', () => {
      if (toggle?.checked) {
        toggle.checked = false;
        setLock(false);
      }
    })
  );
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && toggle?.checked) {
      toggle.checked = false;
      setLock(false);
    }
  });

  // 配色の切り替え。未設定のときはOSの設定を初期値として反転させる
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>
