---
/**
 * 下層ページの見出しとパンくず。
 * パンくずの構造化データは Layout 側で breadcrumbs から出す。
 */
import type { Crumb } from '../layouts/Layout.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  breadcrumbs: Crumb[];
}

const { eyebrow, title, lead, breadcrumbs } = Astro.props;
const crumbs = [{ label: 'ホーム', href: '/' }, ...breadcrumbs];
---

<section class="relative overflow-hidden border-b border-line bg-ground">
  <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-brand-soft blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-10 md:py-16">
    <nav aria-label="パンくずリスト">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
        {
          crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < crumbs.length - 1 ? (
                <a href={c.href} class="hover:text-brand hover:underline">{c.label}</a>
              ) : (
                <span aria-current="page" class="text-ink-2">{c.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="eyebrow mt-8">{eyebrow}</p>
    <h1 class="mt-2 text-3xl leading-snug font-black tracking-tight text-balance md:text-[2.6rem]">{title}</h1>
    {lead && <p class="mt-5 max-w-3xl leading-relaxed text-ink-2 md:text-lg">{lead}</p>}
  </div>
</section>
