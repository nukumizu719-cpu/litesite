---
interface Props {
  /** 小さいラベル（英字） */
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="border-b border-line">
  <div class="mx-auto max-w-3xl px-5 pt-12 pb-10 md:pt-16 md:pb-12">
    {
      eyebrow && (
        <p class="flex items-center gap-3 font-[family-name:var(--font-mono)] text-[10px] font-semibold tracking-[0.22em] text-dirt uppercase">
          {eyebrow}
          <span class="h-px flex-1 bg-line" />
        </p>
      )
    }
    <h1 class="mt-4 font-[family-name:var(--font-display)] text-[1.9rem] leading-[1.3] font-extrabold text-balance md:text-[2.5rem]">
      {title}
    </h1>
    {lead && <p class="mt-5 text-[0.97rem] leading-relaxed text-ink-2">{lead}</p>}
    <slot />
  </div>
</header>
