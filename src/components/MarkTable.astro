---
import WakuBadge from './WakuBadge.astro';

interface Mark {
  no: number;
  name: string;
  mark: string;
  pop?: number;
  odds?: number;
  deduction?: number;
  note?: string;
}

interface Props {
  marks: Mark[];
  headCount: number;
  axis: string;
}

const { marks, headCount, axis } = Astro.props;

const markStyle: Record<string, string> = {
  '◎': 'text-miss',
  '○': 'text-turf',
  '▲': 'text-ink',
  '△': 'text-ink-2',
  '☆': 'text-dirt',
  '消': 'text-muted line-through decoration-1',
};
const hasDeduction = marks.some((m) => typeof m.deduction === 'number');
---

<div class="scroll-x rounded-lg border border-line bg-surface">
  <table class="w-full min-w-[520px] border-collapse text-sm">
    <thead>
      <tr class="bg-surface-2 text-left font-[family-name:var(--font-mono)] text-[10px] tracking-[0.12em] text-muted uppercase">
        <th class="px-3 py-2.5 font-semibold">印</th>
        <th class="px-3 py-2.5 font-semibold">馬番</th>
        <th class="px-3 py-2.5 font-semibold">馬名</th>
        <th class="px-3 py-2.5 text-right font-semibold">人気</th>
        <th class="px-3 py-2.5 text-right font-semibold">単勝</th>
        {hasDeduction && <th class="px-3 py-2.5 text-right font-semibold">減点</th>}
        <th class="px-3 py-2.5 font-semibold">メモ</th>
      </tr>
    </thead>
    <tbody>
      {
        marks.map((m) => (
          <tr class="border-t border-line-soft align-middle">
            <td class:list={['px-3 py-2.5 text-lg leading-none font-bold', markStyle[m.mark] ?? 'text-ink']}>
              {m.mark}
            </td>
            <td class="px-3 py-2.5">
              <WakuBadge no={m.no} headCount={headCount} size="sm" />
            </td>
            <td class="px-3 py-2.5 font-medium whitespace-nowrap">
              {m.name}
              {m.name === axis && (
                <span class="ml-1.5 rounded-[3px] bg-turf-soft px-1.5 py-0.5 align-middle font-[family-name:var(--font-mono)] text-[9px] tracking-wider text-turf">
                  軸
                </span>
              )}
            </td>
            <td class="px-3 py-2.5 text-right font-[family-name:var(--font-mono)] tabular-nums text-ink-2">
              {m.pop ?? '—'}
            </td>
            <td class="px-3 py-2.5 text-right font-[family-name:var(--font-mono)] tabular-nums text-ink-2">
              {m.odds != null ? m.odds.toFixed(1) : '—'}
            </td>
            {hasDeduction && (
              <td
                class:list={[
                  'px-3 py-2.5 text-right font-[family-name:var(--font-mono)] font-semibold tabular-nums',
                  (m.deduction ?? 0) === 0 ? 'text-hit' : 'text-miss',
                ]}
              >
                {typeof m.deduction === 'number' ? m.deduction : '—'}
              </td>
            )}
            <td class="px-3 py-2.5 text-xs leading-relaxed text-ink-2">{m.note ?? ''}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{
  hasDeduction && (
    <p class="mt-3 text-xs leading-relaxed text-muted">
      減点は<a href="/logic/checklist/" class="underline underline-offset-2 hover:text-turf">人気馬チェックリスト</a>
      による評価です。0に近いほど不安要素が少ないことを示します。
    </p>
  )
}
