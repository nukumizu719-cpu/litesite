---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import { SITE, BUSINESS, AREAS, LINE_URL } from '../config';
import { PLANS } from '../data/plans';
import '../styles/global.css';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  /** ページ固有のタイトル。省略するとトップ用のタイトルになる */
  title?: string;
  description?: string;
  /** OGP画像のパス */
  image?: string;
  type?: 'website' | 'article';
  /** パンくず（トップは自動で先頭に付く）。構造化データにも使う */
  breadcrumbs?: Crumb[];
  /** article のとき、公開日・更新日 */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 検索エンジンにインデックスさせない */
  noindex?: boolean;
  /** 下部の固定CTAバーを出さない（お問い合わせページなど） */
  hideCtaBar?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  breadcrumbs = [],
  publishedTime,
  modifiedTime,
  noindex = false,
  hideCtaBar = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const fullTitle = title ? `${title}｜${SITE.titleSuffix}` : SITE.homeTitle;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
const orgId = `${SITE.url}/#business`;

const address = {
  '@type': 'PostalAddress',
  addressRegion: BUSINESS.region,
  addressLocality: BUSINESS.locality,
  addressCountry: 'JP',
  ...(BUSINESS.postalCode ? { postalCode: BUSINESS.postalCode } : {}),
  ...(BUSINESS.street ? { streetAddress: BUSINESS.street } : {}),
};

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.titleSuffix,
    alternateName: [SITE.name, SITE.nameKana],
    url: `${SITE.url}/`,
    inLanguage: 'ja',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'ProfessionalService',
    '@id': orgId,
    name: SITE.titleSuffix,
    alternateName: [SITE.name, SITE.nameKana],
    description: SITE.description,
    url: `${SITE.url}/`,
    logo: `${SITE.url}/icon-512.png`,
    image: `${SITE.url}${SITE.ogImage}`,
    email: BUSINESS.email,
    ...(BUSINESS.tel ? { telephone: BUSINESS.tel } : {}),
    address,
    areaServed: [
      ...[...AREAS.main, ...AREAS.nearby].map((name) => ({ '@type': 'City', name })),
      { '@type': 'AdministrativeArea', name: '愛知県' },
    ],
    priceRange: `¥${Math.min(...PLANS.map((p) => p.price)).toLocaleString('en-US')}〜`,
    ...(LINE_URL ? { sameAs: [LINE_URL] } : {}),
    makesOffer: PLANS.map((p) => ({
      '@type': 'Offer',
      name: `ホームページ制作 ${p.name}`,
      price: p.price,
      priceCurrency: 'JPY',
      url: `${SITE.url}/price/`,
      itemOffered: { '@type': 'Service', name: 'ホームページ制作', serviceType: 'Webサイト制作' },
    })),
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'ホーム', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, siteUrl).toString(),
    })),
  });
}

if (type === 'article') {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: ogImageURL.toString(),
    mainEntityOfPage: canonicalURL.toString(),
    inLanguage: 'ja',
    author: { '@id': orgId },
    publisher: { '@id': orgId },
    ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#004aad" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.titleSuffix} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />

    {
      SITE.gaId && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          {/* define:vars を使うとスクリプト全体が関数で包まれるため、gtag は window に明示的に置く。
              こうしないとフォーム送信（generate_lead）やクリック計測から gtag を呼べない */}
          <script is:inline define:vars={{ GA_ID: SITE.gaId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', GA_ID);
          </script>
        </Fragment>
      )
    }
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >本文へスキップ</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {!hideCtaBar && <MobileCtaBar />}

    <script>
      // スクロールで .fade-in を表示
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.fade-in').forEach((el) => io.observe(el));

      // 問い合わせ導線のクリックをGA4に送る（data-cta="場所" を付けたリンク）
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cta]');
        if (!a || typeof window.gtag !== 'function') return;
        const isLine = a.href.includes('line.me');
        window.gtag('event', isLine ? 'line_click' : 'cta_click', {
          cta_location: a.dataset.cta,
          link_url: a.href,
        });
      });
    </script>
  </body>
</html>
