---
import Layout from '../layouts/Layout.astro';
---

<Layout title="送信が完了しました" noindex={true}>
  <div class="mx-auto flex max-w-xl flex-col items-center px-5 py-24 text-center">
    <div class="grid h-14 w-14 place-items-center rounded-full bg-turf-soft">
      <svg class="h-7 w-7 text-turf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6L9 17l-5-5"></path>
      </svg>
    </div>
    <h1 class="mt-6 font-[family-name:var(--font-display)] text-2xl font-bold">
      送信が完了しました
    </h1>
    <p class="mt-4 leading-relaxed text-ink-2">
      お問い合わせありがとうございます。<br />
      内容を確認のうえ、数日以内にご返信します。
    </p>
    <a
      href="/"
      class="mt-8 rounded-full border border-line px-6 py-3 text-sm font-bold text-ink-2 transition-colors hover:border-turf hover:text-turf"
    >
      トップへ戻る
    </a>
  </div>
</Layout>
