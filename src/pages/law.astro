---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, BUSINESS } from '../config';
import { PLANS, formatYen } from '../data/plans';

const breadcrumbs = [{ label: '特定商取引法に基づく表記', href: '/law/' }];

// 未設定の項目は、特定商取引法の省略の規定に沿って「請求により開示」と表示する
const onRequest = '請求があった場合には、遅滞なく開示いたします。';
const address = BUSINESS.street
  ? `${BUSINESS.postalCode ? `〒${BUSINESS.postalCode} ` : ''}${BUSINESS.region}${BUSINESS.locality}${BUSINESS.street}`
  : onRequest;

const rows = [
  { label: '販売事業者', value: SITE.titleSuffix },
  { label: '代表者', value: BUSINESS.owner || onRequest },
  { label: '所在地', value: address },
  { label: '電話番号', value: BUSINESS.tel || onRequest },
  { label: 'メールアドレス', value: BUSINESS.email },
  {
    label: '販売価格',
    value: PLANS.map((p) => `${p.name}：制作費${formatYen(p.initial)}〜${p.monthly ? `、月額${formatYen(p.monthly)}` : ''}（税込）`).join('\n') +
      '\n最終的な金額は、ヒアリング後にお出しするお見積りによります。',
  },
  { label: '商品代金以外の必要料金', value: '銀行振込の場合の振込手数料\nセルフ運用プランの場合のドメイン・サーバーの実費' },
  { label: 'お支払い方法', value: '銀行振込、クレジットカード' },
  { label: 'お支払い時期', value: 'お見積り・ご契約時にご案内します。' },
  { label: '役務の提供時期', value: '制作着手から通常1ヶ月程度（契約内容や素材のご提供時期により前後します）' },
  {
    label: 'キャンセル・解約',
    value: 'サービスの性質上、制作着手後のキャンセルはお受けしておりません。\n安心サブスクプランの解約は、解約希望月の前月末日までにお申し出いただくことで、翌月から停止します。',
  },
];
---

<Layout
  title="特定商取引法に基づく表記"
  description="LiteSite（ライトサイト）の特定商取引法に基づく表記です。"
  breadcrumbs={breadcrumbs}
>
  <PageHeader eyebrow="Legal" title="特定商取引法に基づく表記" breadcrumbs={breadcrumbs} />

  <div class="container-x py-12 md:py-16">
    <dl class="mx-auto max-w-3xl divide-y divide-line rounded-3xl border border-line bg-white">
      {
        rows.map((r) => (
          <div class="grid gap-1 px-6 py-5 md:grid-cols-3 md:gap-6 md:px-8">
            <dt class="font-bold">{r.label}</dt>
            <dd class="whitespace-pre-line text-ink-2 md:col-span-2">{r.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Layout>
