---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ColumnCard from '../../components/ColumnCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { formatDate } from '../../lib/format';
import { SITE, BUSINESS } from '../../config';

export async function getStaticPaths() {
  const entries = await getCollection('column', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { title, description, publishedAt, updatedAt, category } = entry.data;

const related = all
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const breadcrumbs = [
  { label: 'コラム', href: '/column/' },
  { label: title, href: `/column/${entry.id}/` },
];
---

<Layout
  title={title}
  description={description}
  type="article"
  publishedTime={publishedAt}
  modifiedTime={updatedAt ?? publishedAt}
  breadcrumbs={breadcrumbs}
>
  <PageHeader eyebrow={category} title={title} breadcrumbs={breadcrumbs} />

  <div class="container-x py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
        <span>公開：<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></span>
        {updatedAt && <span>更新：<time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span>}
        <span>執筆：{SITE.titleSuffix}</span>
      </p>

      <article class="prose mt-10">
        <Content />
      </article>

      <aside class="mt-16 rounded-3xl border border-brand-line bg-brand-soft/60 p-7 md:p-9">
        <p class="text-lg font-black">この記事を書いた LiteSite について</p>
        <p class="mt-3 leading-relaxed text-ink-2">
          {BUSINESS.region}{BUSINESS.locality}を拠点に、名古屋・西三河エリアの個人事業主・小規模事業者のホームページを制作しています。表示が速く管理の手間がいらない静的サイトで、制作費は229,000円〜（税込）、月額管理費0円のプランからお選びいただけます。
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/service/" class="btn btn-ghost px-6 py-3 text-sm">サービス内容を見る</a>
          <a href="/contact/" data-cta="column_author" class="btn btn-primary px-6 py-3 text-sm">無料で相談する</a>
        </div>
      </aside>

      {
        related.length > 0 && (
          <section class="mt-16">
            <h2 class="text-xl font-black">あわせて読みたい</h2>
            <ul class="mt-6 grid gap-5 md:grid-cols-2">
              {related.map((r) => (
                <li>
                  <ColumnCard entry={r} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>

  <CtaSection location="column_bottom" />
</Layout>
