---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE, BUSINESS, AREAS, LINE_URL } from '../config';

const breadcrumbs = [{ label: '運営者情報', href: '/about/' }];

const rows = [
  { label: '屋号', value: SITE.titleSuffix },
  { label: '代表者', value: BUSINESS.owner },
  { label: '所在地', value: `${BUSINESS.postalCode ? `〒${BUSINESS.postalCode} ` : ''}${BUSINESS.region}${BUSINESS.locality}${BUSINESS.street}` },
  { label: '事業内容', value: 'ホームページの企画・制作、公開後の運用・保守、Web集客のご相談' },
  { label: '対応エリア', value: `${AREAS.main.join('・')}を中心に愛知県全域（県外はオンライン対応）` },
  { label: '営業時間', value: `${BUSINESS.hours}（${BUSINESS.hoursNote}）` },
  { label: '電話番号', value: BUSINESS.tel },
  { label: 'メール', value: BUSINESS.email },
].filter((r) => r.value);
---

<Layout
  title="運営者情報"
  description="LiteSite（ライトサイト）は愛知県安城市を拠点に、名古屋・西三河エリアの個人事業主・小規模事業者のホームページを制作しています。屋号・所在地・事業内容・対応エリアのご案内。"
  breadcrumbs={breadcrumbs}
>
  <PageHeader eyebrow="About" title="運営者情報" breadcrumbs={breadcrumbs} />

  <section class="py-14 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <div class="fade-in prose">
          <h2>小さな事業者のための、ちょうどいいホームページを</h2>
          <p>
            LiteSite（ライトサイト）は、愛知県{BUSINESS.locality}を拠点にホームページ制作を請け負っています。お客様の多くは、ひとりや少人数で事業を営む個人事業主・小規模事業者の方です。
          </p>
          <p>
            そうした方にとって、WordPressの更新作業や毎月の管理費は、本業の時間とお金を少しずつ奪う負担になりがちです。LiteSiteでは、表示が速く、管理の手間がほとんどいらない「静的サイト」という作り方を選び、作ったあとも負担にならないホームページを届けることを大切にしています。
          </p>
          <p>
            制作会社のような分業ではなく、ヒアリングから設計・制作・公開まで同じ担当者が行います。伝えたことが途中で抜け落ちず、公開後の相談もそのまま同じ相手にできます。
          </p>
        </div>

        <h2 class="mt-16 text-xl font-black">事業者概要</h2>
        <dl class="mt-6 divide-y divide-line rounded-3xl border border-line bg-white">
          {
            rows.map((r) => (
              <div class="grid gap-1 px-6 py-5 md:grid-cols-4 md:gap-6 md:px-8">
                <dt class="font-bold">{r.label}</dt>
                <dd class="text-ink-2 md:col-span-3">{r.value}</dd>
              </div>
            ))
          }
          {
            LINE_URL && (
              <div class="grid gap-1 px-6 py-5 md:grid-cols-4 md:gap-6 md:px-8">
                <dt class="font-bold">LINE</dt>
                <dd class="md:col-span-3">
                  <a href={LINE_URL} target="_blank" rel="noopener noreferrer" data-cta="about" class="font-bold text-brand underline">
                    LINEで友だち追加する
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>

  <CtaSection location="about_bottom" />
</Layout>
