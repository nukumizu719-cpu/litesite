---
/**
 * スタイリッシュ・ページネーション版 (src/pages/blog/[page].astro)
 * 1. 衝突回避リンク: 記事詳細へのリンクを /blog/article/[id]/ へ修正。
 * 2. 数値ナビゲーション: ページ番号を並べ、直感的な操作感を実現。
 * 3. アクティブ表示: 現在のページをLiteSiteブルーで強調。
 */
import Layout from "../../layouts/Layout.astro";
import { client } from "../../library/microcms";
import type { Blog } from "../../library/microcms";

export async function getStaticPaths({ paginate }: any) {
  const response = await client.get({
    endpoint: "blogs",
    queries: { 
      orders: "-publishedAt",
      limit: 100 
    }
  });
  const posts = response.contents as Blog[];

  // 9件ごとにページを分割
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;

// 全ページ番号の配列を作成（例: [1, 2, 3]）
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

<Layout 
  title={`お知らせ・コラム ${page.currentPage}ページ目 | LiteSite`}
  description="名古屋・愛知のホームページ制作、補助金活用に関する最新情報の一覧です。"
>
  <div class="py-24 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-6">
      
      <header class="mb-20 text-center">
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tighter">
          Archive
        </h1>
        <p class="text-slate-600 font-medium">
          情報を価値に変える、LiteSiteの視点。
        </p>
      </header>

      {/* 記事一覧グリッド */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {page.data.map((post: Blog) => (
          <article>
            <a 
              href={`/blog/article/${post.id}/`} 
              class="group flex flex-col bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 h-full"
            >
              <div class="aspect-video bg-slate-200 relative overflow-hidden">
                {post.eyecatch ? (
                  <img src={post.eyecatch.url} alt={post.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-slate-400 font-bold">No Image</div>
                )}
                {post.category && (
                  <div class="absolute top-4 left-4">
                    <span class="bg-blue-600 text-white text-[10px] font-black px-3 py-1 rounded-full shadow-lg">
                      {post.category.name}
                    </span>
                  </div>
                )}
              </div>

              <div class="p-8 flex-grow flex flex-col">
                <time class="text-[10px] text-slate-400 font-bold tracking-widest mb-3 block uppercase">
                  {new Date(post.publishedAt).toLocaleDateString('ja-JP').replace(/\//g, '.')}
                </time>
                <h2 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                  {post.title}
                </h2>
                <div class="mt-auto pt-4 flex items-center text-blue-600 text-[10px] font-black tracking-widest uppercase">
                  READ MORE
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      {/* スタイリッシュ・ページネーション */}
      <nav class="mt-24 flex justify-center items-center gap-2 md:gap-4">
        
        {/* 前へ */}
        {page.url.prev ? (
          <a href={page.url.prev} class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-900 hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all shadow-sm group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
        ) : (
          <span class="w-12 h-12 flex items-center justify-center rounded-2xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </span>
        )}

        {/* ページ番号リスト */}
        <div class="flex items-center gap-2">
          {pageNumbers.map((num) => (
            <a 
              href={`/blog/${num}/`}
              class={`w-12 h-12 flex items-center justify-center rounded-2xl font-bold transition-all shadow-sm
                ${page.currentPage === num 
                  ? "bg-blue-600 text-white shadow-blue-200 shadow-lg scale-110 z-10" 
                  : "bg-white border border-slate-200 text-slate-600 hover:border-blue-400 hover:text-blue-600"
                }`}
            >
              {num}
            </a>
          ))}
        </div>

        {/* 次へ */}
        {page.url.next ? (
          <a href={page.url.next} class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-900 hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all shadow-sm group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <span class="w-12 h-12 flex items-center justify-center rounded-2xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        )}
      </nav>

      <div class="mt-24 text-center">
        <a href="/" class="text-slate-400 text-sm font-bold hover:text-slate-900 transition-colors tracking-widest uppercase">
          Back to Top
        </a>
      </div>

    </div>
  </div>
</Layout>