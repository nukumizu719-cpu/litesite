---
import Layout from "../../../layouts/Layout.astro";
import { client } from "../../../library/microcms";
import type { Blog } from "../../../library/microcms";

export async function getStaticPaths() {
  const response = await client.get({ endpoint: "blogs" });
  return response.contents.map((content: any) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;
const post = await client.get({ 
  endpoint: "blogs", 
  contentId: id 
}) as Blog;

const publishedDate = new Date(post.publishedAt).toLocaleDateString('ja-JP').replace(/\//g, '.');
---

<Layout 
  title={`${post.title} | LiteSite ブログ`}
  description={`${post.title}の解説記事です。`}
>
  <article class="pt-12 pb-24 bg-white min-h-screen">
    <div class="container mx-auto px-6 max-w-7xl">
      
      {/* 2カラムレイアウトの開始 */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 xl:gap-16">
        
        {/* --- 左側：メイン記事エリア (8カラム) --- */}
        <div class="lg:col-span-8">
          <header class="mb-12 pb-12 border-b border-slate-100">
            <div class="flex items-center gap-4 mb-6">
              {post.category && (
                <span class="bg-blue-600 text-white text-[10px] font-black px-4 py-1.5 rounded-full tracking-widest uppercase">
                  {post.category.name}
                </span>
              )}
              <time class="text-slate-400 text-sm font-bold tracking-tighter">
                {publishedDate}
              </time>
            </div>
            
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 leading-[1.2] tracking-tighter mb-10">
              {post.title}
            </h1>

            {post.eyecatch && (
              <div class="rounded-[2.5rem] overflow-hidden shadow-xl border border-slate-100 aspect-video relative">
                <img 
                  src={post.eyecatch.url} 
                  alt={post.title} 
                  class="w-full h-full object-cover"
                />
              </div>
            )}
          </header>

          {/* 記事本文 */}
          <div class="prose prose-slate lg:prose-xl prose-headings:text-slate-900 prose-headings:font-black prose-headings:tracking-tighter prose-a:text-blue-600 prose-img:rounded-3xl prose-strong:text-slate-900 max-w-none">
            <div set:html={post.content} />
          </div>

          <footer class="mt-20 pt-10 border-t border-slate-100">
            <a href="/blog/1/" class="inline-flex items-center gap-3 text-slate-900 font-bold hover:text-blue-600 transition-all group px-8 py-4 bg-slate-50 rounded-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              記事一覧へ戻る
            </a>
          </footer>
        </div>

        {/* --- 右側：サイドバーエリア (4カラム) --- */}
        <aside class="lg:col-span-4 lg:pt-4">
          <div class="sticky top-24 space-y-10">
            
            {/* プロフィール・CTA枠 */}
            <div class="p-8 bg-slate-900 rounded-[2.5rem] text-white shadow-2xl overflow-hidden relative group">
              <div class="relative z-10">
                <h3 class="text-xl font-black mb-4 tracking-tighter">LiteSite 制作相談</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-8 font-medium">
                  名古屋・愛知での補助金を活用したホームページ制作。実質負担5.7万円〜で爆速SEOサイトを構築します。
                </p>
                <a href="/contact/" class="block w-full text-center bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-2xl font-black transition-all shadow-lg active:scale-95">
                  無料相談・お見積り
                </a>
              </div>
              {/* 装飾用背景 */}
              <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-blue-600/20 rounded-full blur-3xl group-hover:bg-blue-600/30 transition-colors"></div>
            </div>

            {/* アフィリエイト・おすすめ商品枠（仮設置） */}
            <div class="p-8 bg-slate-50 rounded-[2.5rem] border border-slate-100">
              <h3 class="text-lg font-black text-slate-900 mb-6 flex items-center gap-2 tracking-tighter">
                <span class="text-xl">💡</span> おすすめのツール
              </h3>
              <div class="space-y-6">
                {/* 毎日入稿する記事に合わせて、ここに自動・手動でリンクを流し込めるようにします */}
                <div class="group cursor-pointer">
                  <div class="bg-white p-2 rounded-2xl mb-3 shadow-sm group-hover:shadow-md transition-shadow border border-slate-100 overflow-hidden">
                    <div class="aspect-video bg-slate-200 rounded-xl mb-1">
                      {/* ここに商品画像 */}
                    </div>
                  </div>
                  <p class="text-sm font-black text-slate-800 leading-snug group-hover:text-blue-600 transition-colors">
                    AIライティングを10倍速にする最強ガジェット紹介
                  </p>
                </div>
              </div>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../../styles/global.css";

  .prose h2 {
    @apply text-2xl md:text-3xl border-l-8 border-blue-600 pl-6 py-2 mt-16 mb-8 bg-slate-50 rounded-r-2xl font-black;
  }
  .prose p {
    @apply leading-[2.1] mb-8 text-slate-700 font-medium;
  }
</style>