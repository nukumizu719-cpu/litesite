---
import Layout from '../layouts/Layout.astro';
import { NAV } from '../config';
---

<Layout title="ページが見つかりません" noindex>
  <section class="py-20 md:py-28">
    <div class="container-x text-center">
      <p class="font-[family-name:var(--font-en)] text-6xl font-bold text-brand-line">404</p>
      <h1 class="mt-4 text-2xl font-black">お探しのページが見つかりません</h1>
      <p class="mt-4 leading-relaxed text-ink-2">URLが変わったか、ページが削除された可能性があります。</p>
      <ul class="mt-10 flex flex-wrap justify-center gap-2.5">
        <li><a href="/" class="btn btn-ghost px-5 py-2.5 text-sm">トップ</a></li>
        {NAV.map((item) => <li><a href={item.href} class="btn btn-ghost px-5 py-2.5 text-sm">{item.label}</a></li>)}
        <li><a href="/contact/" class="btn btn-primary px-5 py-2.5 text-sm">お問い合わせ</a></li>
      </ul>
    </div>
  </section>
</Layout>
